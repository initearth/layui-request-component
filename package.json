{
  "name": "@initearth/layui-request-component",
  "version": "1.0.0",
  "description": "HTTP request component for layui with interceptors, cancellation, upload and download",
  "license": "MIT",
  "main": "dist/request.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/request.js"
    }
  },
  "files": [
    "dist",
    "example",
    "README.md"
  ],
  "sideEffects": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build:js": "rollup --config",
    "build:types": "tsc --project tsconfig.build.json",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node ./scripts/serve.mjs",
    "watch": "node ./scripts/watch.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "publish:dry-run": "npm run check && npm pack --dry-run"
  },
  "keywords": [
    "layui",
    "component",
    "request",
    "http",
    "xhr"
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.0.0",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
